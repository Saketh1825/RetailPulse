# Copy to .env and edit.  .env is git-ignored -- never commit real secrets.

# Read/write connection (ETL, forecast job, normal API endpoints)
DATABASE_URL=postgresql://retailpulse:CHANGE_ME@localhost:5432/retailpulse

# SELECT-only connection (natural-language queries ONLY). scripts/init_db.py creates this role
# with exactly the user/password written here.
READONLY_DATABASE_URL=postgresql://retailpulse_readonly:CHANGE_ME_TOO@localhost:5432/retailpulse

# LLM: any OpenAI-compatible chat-completions endpoint. Check your provider's docs for the current
# base URL, model names and free-tier limits (they change).
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Optional hardening
API_KEY=                       # if set, POST /query requires header  X-API-Key: <value>
QUERY_RATE_LIMIT_PER_MINUTE=20
NL_MAX_ROWS=200
NL_STATEMENT_TIMEOUT_MS=5000
